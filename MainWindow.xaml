<Window x:Class="WindowShield.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WindowShield — Presentation Privacy Software"
        Height="720" Width="1080"
        MinHeight="600" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="#121417"
        Foreground="#F0F2F5">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>

        <!-- Custom ScrollBar Style -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="8"/>
        </Style>

        <!-- Custom Button Style -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1F2329"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#303642"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2A303A"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#00E5FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#15181E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Background" Value="#0088CC"/>
            <Setter Property="BorderBrush" Value="#00A8FF"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0099EE"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0077BB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Action Bar & Search -->
            <RowDefinition Height="*"/>    <!-- Main Content Grid -->
            <RowDefinition Height="Auto"/> <!-- Footer Status Bar -->
        </Grid.RowDefinitions>

        <!-- Top Header Navigation Bar -->
        <Border Grid.Row="0" Background="#181B20" BorderBrush="#262C36" BorderThickness="0,0,0,1" Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Border Background="#2000E5FF" CornerRadius="10" Padding="10,6" Margin="0,0,12,0">
                        <TextBlock Text="🛡️" FontSize="22" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="WindowShield" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF"/>
                            <Border Background="#00E5FF" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="PRO PRIVACY" Foreground="#000000" FontSize="10" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Presentation Privacy &amp; App Masking Engine" Foreground="#8A94A6" FontSize="12" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Status Badge -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="StatusBadge" Background="#2000E5FF" BorderBrush="#00E5FF" BorderThickness="1" CornerRadius="20" Padding="14,6" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusPulse" Width="8" Height="8" Fill="#00E5FF" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtStatus" Text="0 Apps Covered" Foreground="#00E5FF" FontSize="12" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>

                    <Button Click="BtnOpenSettings_Click" Style="{StaticResource ModernButtonStyle}" Content="⚙️ Settings" Padding="10,6"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Action Bar & Controls -->
        <Border Grid.Row="1" Background="#14171C" BorderBrush="#222731" BorderThickness="0,0,0,1" Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <!-- Target Picker Crosshair Tool -->
                    <Button Click="BtnLaunchPicker_Click" Style="{StaticResource AccentButtonStyle}" Margin="0,0,10,0" ToolTip="Click on any window on your desktop to cover it">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🎯" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Target Picker Tool" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Click="BtnRefreshList_Click" Style="{StaticResource ModernButtonStyle}" Margin="0,0,10,0" ToolTip="Scan for newly opened applications">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔄" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Refresh Apps" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Click="BtnUncoverAll_Click" Style="{StaticResource ModernButtonStyle}" Margin="0,0,10,0" ToolTip="Remove all active gray privacy boxes">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔓" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Uncover All" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Search Input Box -->
                <Border Grid.Column="1" Background="#1A1E24" BorderBrush="#2E3542" BorderThickness="1" CornerRadius="6" Width="260" Padding="10,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="🔍" Foreground="#6C7A8E" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="TxtSearch"
                                 Grid.Column="1"
                                 TextChanged="TxtSearch_TextChanged"
                                 Background="Transparent"
                                 Foreground="#FFFFFF"
                                 BorderThickness="0"
                                 FontSize="13"
                                 VerticalAlignment="Center"
                                 GotFocus="TxtSearch_GotFocus"
                                 LostFocus="TxtSearch_LostFocus"/>
                        <TextBlock x:Name="SearchPlaceholder"
                                   Grid.Column="1"
                                   Text="Filter running apps..."
                                   Foreground="#5A6578"
                                   FontSize="13"
                                   IsHitTestVisible="False"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Main Body: Active Windows List + Settings Panel -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="ColSettings" Width="0"/> <!-- Expandable Settings Panel -->
            </Grid.ColumnDefinitions>

            <!-- Application Windows Grid -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="24,18">
                <ItemsControl x:Name="AppsListView">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#1A1E24"
                                    BorderBrush="#29303D"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Margin="0,0,0,10"
                                    Padding="16,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/> <!-- App Icon -->
                                        <ColumnDefinition Width="*"/>    <!-- App Title & Process -->
                                        <ColumnDefinition Width="Auto"/> <!-- Coverage Toggle Buttons -->
                                    </Grid.ColumnDefinitions>

                                    <!-- App Icon -->
                                    <Border Grid.Column="0" Width="42" Height="42" Background="#242B36" CornerRadius="8" Margin="0,0,14,0" VerticalAlignment="Center">
                                        <Image Source="{Binding Icon}" Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- App Details -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}"
                                                   Foreground="#FFFFFF"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <Border Background="#28303E" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding ProcessName}" Foreground="#00E5FF" FontSize="11" FontWeight="Bold"/>
                                            </Border>
                                            <TextBlock Text="{Binding ExecutablePath}" Foreground="#6C7A8E" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="350"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Action Buttons -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Stealth Capture Toggle -->
                                        <ToggleButton IsChecked="{Binding IsStealthMode, Mode=OneWay}"
                                                      Click="BtnToggleStealth_Click"
                                                      Tag="{Binding}"
                                                      Margin="0,0,8,0"
                                                      ToolTip="Stealth Mode: Visible to you on screen, but shows as a black box to Google Meet &amp; MS Teams attendees">
                                            <ToggleButton.Template>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border x:Name="b" Background="#242B36" BorderBrush="#364052" BorderThickness="1" CornerRadius="6" Padding="12,7">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock x:Name="tbIcon" Text="👁️" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                            <TextBlock x:Name="tbText" Text="Stealth Mode" Foreground="#FFFFFF" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter TargetName="b" Property="Background" Value="#6A1B9A"/>
                                                            <Setter TargetName="b" Property="BorderBrush" Value="#E040FB"/>
                                                            <Setter TargetName="tbText" Property="Text" Value="👁️ Stealth Active"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </ToggleButton.Template>
                                        </ToggleButton>

                                        <!-- Gray Box Overlay Toggle -->
                                        <ToggleButton IsChecked="{Binding IsCovered, Mode=OneWay}"
                                                      Click="BtnToggleOverlay_Click"
                                                      Tag="{Binding}"
                                                      Padding="14,6"
                                                      Cursor="Hand">
                                            <ToggleButton.Template>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border x:Name="b" Background="#242B36" BorderBrush="#364052" BorderThickness="1" CornerRadius="6" Padding="14,7">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock x:Name="tbIcon" Text="🔒" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                            <TextBlock x:Name="tbText" Text="Cover App" Foreground="#FFFFFF" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter TargetName="b" Property="Background" Value="#0088CC"/>
                                                            <Setter TargetName="b" Property="BorderBrush" Value="#00E5FF"/>
                                                            <Setter TargetName="tbText" Property="Text" Value="Covered (Gray Box)"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </ToggleButton.Template>
                                        </ToggleButton>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Settings Side Panel -->
            <Border Grid.Column="1" x:Name="PanelSettings" Background="#181C22" BorderBrush="#282E38" BorderThickness="1,0,0,0" Padding="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <TextBlock Text="⚙️ Customization &amp; Options" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                            <Button Click="BtnCloseSettings_Click" HorizontalAlignment="Right" Style="{StaticResource ModernButtonStyle}" Content="✕" Padding="6,2"/>
                        </Grid>

                        <!-- Gray Box Opacity -->
                        <TextBlock Text="Gray Box Opacity" Foreground="#8A94A6" FontSize="12" FontWeight="SemiBold" Margin="0,10,0,6"/>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="SliderOpacity" Minimum="0.1" Maximum="1.0" Value="0.95" ValueChanged="SliderOpacity_ValueChanged" TickFrequency="0.05" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" x:Name="TxtOpacityVal" Text="95%" Foreground="#00E5FF" FontWeight="Bold" Margin="10,0,0,0"/>
                        </Grid>

                        <!-- Custom Gray Color Hex -->
                        <TextBlock Text="Gray Box Color Theme" Foreground="#8A94A6" FontSize="12" FontWeight="SemiBold" Margin="0,6,0,6"/>
                        <WrapPanel Margin="0,0,0,16">
                            <Button Click="BtnPresetColor_Click" Tag="#25282A" Width="36" Height="36" Background="#25282A" BorderBrush="#00E5FF" BorderThickness="2" Margin="0,0,8,8" ToolTip="Slate Gray"/>
                            <Button Click="BtnPresetColor_Click" Tag="#1A1D20" Width="36" Height="36" Background="#1A1D20" BorderBrush="#40FFFFFF" BorderThickness="1" Margin="0,0,8,8" ToolTip="Charcoal Dark"/>
                            <Button Click="BtnPresetColor_Click" Tag="#18222D" Width="36" Height="36" Background="#18222D" BorderBrush="#40FFFFFF" BorderThickness="1" Margin="0,0,8,8" ToolTip="Midnight Navy"/>
                            <Button Click="BtnPresetColor_Click" Tag="#101012" Width="36" Height="36" Background="#101012" BorderBrush="#40FFFFFF" BorderThickness="1" Margin="0,0,8,8" ToolTip="Jet Black"/>
                        </WrapPanel>

                        <!-- Custom Label Text -->
                        <TextBlock Text="Overlay Privacy Text" Foreground="#8A94A6" FontSize="12" FontWeight="SemiBold" Margin="0,6,0,6"/>
                        <TextBox x:Name="TxtCustomLabel" Text="🔒 Covered for Presentation" TextChanged="TxtCustomLabel_TextChanged" Background="#121519" Foreground="#FFFFFF" BorderBrush="#2E3542" BorderThickness="1" Padding="10,8" FontSize="13" Margin="0,0,0,16"/>

                        <!-- Title Bar Clearance Height -->
                        <TextBlock Text="Title Bar Uncovered Height (Close/Min/Max Buttons)" Foreground="#8A94A6" FontSize="12" FontWeight="SemiBold" Margin="0,10,0,6"/>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="SliderTitleBar" Minimum="35" Maximum="75" Value="48" ValueChanged="SliderTitleBar_ValueChanged" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" x:Name="TxtTitleBarVal" Text="48 px" Foreground="#00E5FF" FontWeight="Bold" Margin="10,0,0,0"/>
                        </Grid>

                        <!-- Options Checkboxes -->
                        <CheckBox x:Name="ChkHideForPresenter" Content="Hide Grey Box on My Screen (Only Viewers See Blocked Area)" IsChecked="False" Checked="ChkHideForPresenter_Changed" Unchecked="ChkHideForPresenter_Changed" Foreground="#00E5FF" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <CheckBox x:Name="ChkExposeTitleBar" Content="Expose Top Title Bar (Keep Window Drag &amp; Close Buttons Accessible)" IsChecked="True" Checked="ChkExposeTitleBar_Changed" Unchecked="ChkExposeTitleBar_Changed" Foreground="#FFFFFF" Margin="0,0,0,10"/>
                        <CheckBox x:Name="ChkShowText" Content="Show Privacy Text on Gray Box" IsChecked="True" Checked="ChkShowText_Changed" Unchecked="ChkShowText_Changed" Foreground="#FFFFFF" Margin="0,0,0,10"/>
                        <CheckBox x:Name="ChkPassThrough" Content="Enable Click Pass-Through Mode (WS_EX_TRANSPARENT)" IsChecked="True" Checked="ChkPassThrough_Changed" Unchecked="ChkPassThrough_Changed" Foreground="#FFFFFF" Margin="0,0,0,16"/>

                        <Border Background="#20FFFFFF" Height="1" Margin="0,8,0,16"/>

                        <!-- Global Shortcuts Reference -->
                        <TextBlock Text="⌨️ Global Hotkeys" Foreground="#8A94A6" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <Border Background="#12151A" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="Uncover All Overlays" Foreground="#FFFFFF" FontSize="12"/>
                                    <TextBlock Text="Ctrl + Shift + H" Foreground="#00E5FF" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid>
                                    <TextBlock Text="Target Picker Tool" Foreground="#FFFFFF" FontSize="12"/>
                                    <TextBlock Text="Ctrl + Shift + P" Foreground="#00E5FF" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Footer Bar -->
        <Border Grid.Row="3" Background="#101215" BorderBrush="#1F242E" BorderThickness="0,1,0,0" Padding="24,10">
            <Grid>
                <TextBlock Text="WindowShield v1.0 — Active Screen Sharing &amp; Presentation Guard" Foreground="#5B6678" FontSize="11" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtFooterCount" Text="Total Active Apps: 0" Foreground="#8A94A6" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
